; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sunset Invaders"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/screens/start_screen.tscn"
config/icon="res://icon.svg"

[autoload]

SceneManager="*res://scripts/autoload/scene_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194319,"physical_keycode":0,"unicode":0,"pressed":true)
, Object(InputEventKey,"keycode":65,"physical_keycode":0,"unicode":97,"pressed":true)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194321,"physical_keycode":0,"unicode":0,"pressed":true)
, Object(InputEventKey,"keycode":68,"physical_keycode":0,"unicode":100,"pressed":true)
]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":32,"physical_keycode":0,"unicode":32,"pressed":true)
]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":82,"physical_keycode":0,"unicode":114,"pressed":true)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/canvas_textures/default_texture_filter=0
